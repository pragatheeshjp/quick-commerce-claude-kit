# Public (browser-visible) values only. Never put secrets here (no service-role key!).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Supabase project URL and PUBLISHABLE (anon) key - Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Server-side (SSR) calls to the API. In Docker Compose this is http://backend:4000 (set in compose.yaml).
# API_INTERNAL_URL=http://localhost:4000
