NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_MAX=300

# Supabase project (Dashboard -> Project Settings -> API). Placeholders only - never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SERVER-ONLY secret key (service_role / sb_secret_...). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-me
